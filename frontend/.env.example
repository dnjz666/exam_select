# 前端环境变量（复制为 .env.local 后按需修改；不要提交 .env.local）

# 浏览器侧 API 基址。
# 留空 = 同源：dev 由 Vite server.proxy 把 /api、/health 转发到 VITE_DEV_API_TARGET。
# AGENTS.md §4.3 硬性规则 5：前端禁止硬编码 localhost，基址一律走本变量。
VITE_API_BASE_URL=

# `vite dev` 的反向代理目标（仅开发期使用，不进任何业务代码）。
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# `pnpm gen:api` 生成 TS 类型时抓取 OpenAPI 的地址。
# 不可用时自动回退到 frontend/openapi.snapshot.json（见 scripts/gen-api-types.mjs）。
API_ORIGIN=http://127.0.0.1:8000
