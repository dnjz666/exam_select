# 运行环境：dev | prod。
# 红线（AGENTS.md §4.3）：allow_origins=["*"] 禁止出现在任何非 dev 配置中。
APP_ENVIRONMENT=dev

# 数据库：dev 用 SQLite，prod 切 PostgreSQL 只改连接串（AGENTS.md §4.1）
DATABASE_URL=sqlite:///./data/exam_select.db

# CORS 允许来源（逗号分隔；dev 默认允许 Vite 5173）
CORS_ORIGINS=http://127.0.0.1:5173

# 模型参数覆盖（可选）。全部参数有默认值，来源 docs/DOMAIN_RULES.md §3，
# 使用 pydantic-settings 嵌套分隔符 __ 覆盖，例如：
# MODEL_PARAMS__HISTORY_YEARS=3
# MODEL_PARAMS__YEAR_WEIGHTS=[0.5,0.3,0.2]
# MODEL_PARAMS__PLAN_BETA=0.4
# MODEL_PARAMS__CV_THRESHOLD=0.15
# MODEL_PARAMS__SAFETY_MARGIN=0.60

# ---- M5 Agent 层（LLM，可选；AGENTS.md §4.1：provider 可插拔）----
# none = 不接 LLM：/chat 走 app/agent/parser.py 的确定性路径
#        （每个数字都来自工具、每句话都过护栏，零编造，可单测）。
# openai = OpenAI 兼容的 /chat/completions（DeepSeek / Qwen / vLLM 等同理）。
# ⚠️ 只有"选了 provider **且** 配了 key"才启用；缺一样就老实用确定性路径。
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
#: 单轮对话内最多几轮"模型请求工具 → 工具返回"往返（防自激循环）
LLM_MAX_TOOL_ROUNDS=4
