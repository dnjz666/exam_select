# ---------- Python ----------
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------- Node ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
pnpm-debug.log*
# pnpm 的 store 落在项目所在盘（C: 的全局 store 与 D: 的项目不同盘时 pnpm 会这样做）
.pnpm-store/

# ---------- 生成物（禁止进版本库，构建时生成）----------
# 前端类型由后端 OpenAPI schema 生成，见 AGENTS.md §4.3
frontend/src/api/schema.d.ts
# 注意：frontend/openapi.snapshot.json **要**进版本库 —— 它是后端 /openapi.json 的副本，
# 供 `pnpm gen:api` 在后端未启动时回退使用（否则 `pnpm build` 依赖后端在跑）。

# ---------- 数据 ----------
data/*.db
# SQLite 回滚日志与临时备份（`sqlite3` 崩溃/被强杀时会留下 journal，M6 实测踩到）
data/*.db-journal
data/*.db.bak-*
data/*.db-wal
data/*.db-shm
data/synthetic/*
!data/synthetic/.gitkeep
data/raw/*
!data/raw/.gitkeep
# 离线引导 wheel 缓存（ADR-007，scripts/bootstrap_wheels.py 可重建）
data/wheels/
# 回测报告为构建产物
backtest_report.json
backtest_report.md

# ---------- 环境与密钥 ----------
.env
.env.local
*.local

# ---------- 工具副产物 ----------
# DSH Desktop (Electron crashpad) 会往工作区根目录写这个文件，非项目产物
debug.log
# agent/开发过程中的临时脚本与日志（`_prof.py` / `_commit_msg.txt` / `_pytest.log` …）
# ★ 实测踩到过：`git add -A` 把提交信息文件也一起提交了
backend/_*

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
